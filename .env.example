# GreenU base URL: do not include /recycle/member; mock is only for local testing.
GREENU_BASE_URL=http://greenu-mock:8000
GREENU_API_KEY=mock-api-key
# Test input only: scripts/smoke.py reads this; backend never falls back to it.
GREENU_ACCESS_CODE=0123456789ABCDEF0123456789ABCDEF
GREENU_MERCHANT=GreenAI
GREENU_TIMEOUT_SECONDS=10

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-local-admin-password
KEYCLOAK_CLIENT_SECRET=replace-with-local-client-secret
POSTGRES_PASSWORD=replace-with-local-db-password
RVM_API_KEY=replace-with-local-device-key
KEYCLOAK_ISSUER=http://localhost:8080/realms/replatform
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
BACKEND_URL=http://localhost:8000
# Example device identity; server config, not trusted from a transaction body.
RVM_BIN_ID=868618051694099
